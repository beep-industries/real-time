# Phoenix Configuration
SECRET_KEY_BASE=generate_using_mix_phx_gen_secret
PHX_HOST=localhost
PORT=4000

# OIDC Authentication
OIDC_JWKS_URL=http://localhost:8080/realms/myrealm/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8080/realms/myrealm
OIDC_AUDIENCE=beep-client

# Redis
REDIS_URL=redis://localhost:6379/0

# SFU gRPC
SFU_GRPC_ADDR=127.0.0.1:50051

# RabbitMQ (if using)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

